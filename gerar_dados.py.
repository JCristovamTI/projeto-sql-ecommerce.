import pandas as pd
from faker import Faker
import random
from datetime import datetime, timedelta

# Inicializa o Faker configurado para dados internacionais/europeus
fake = Faker(['en_US', 'pt_PT'])

# 1. Gerando Dados de Clientes (Customers)
clientes = []
for i in range(1, 101):  # 100 clientes
    clientes.append({
        "id_cliente": i,
        "nome": fake.name(),
        "email": fake.email(),
        "pais": random.choice(["Portugal", "Alemanha", "Canadá", "Brasil", "Espanha"]),
        "data_cadastro": fake.date_between(start_date='-2y', end_date='today')
    })

df_clientes = pd.DataFrame(clientes)

# 2. Gerando Dados de Pedidos (Orders)
pedidos = []
status_opcoes = ["Entregue", "Cancelado", "Em trânsito"]
moedas = ["EUR", "USD"]

for i in range(1, 501):  # 500 pedidos
    id_cliente_aleatorio = random.randint(1, 100)
    data_pedido = fake.date_time_between(start_date='-1y', end_date='now')
    # Calcula data de entrega simulada (alguns dias após o pedido)
    data_entrega = data_pedido + timedelta(days=random.randint(2, 10)) if random.choice([True, True, False]) else None

    pedidos.append({
        "id_pedido": i,
        "id_cliente": id_cliente_aleatorio,
        "data_pedido": data_pedido,
        "data_entrega": data_entrega,
        "valor_total": round(random.uniform(15.0, 1200.0), 2),
        "moeda": random.choice(moedas),
        "status": random.choice(status_opcoes)
    })

df_pedidos = pd.DataFrame(pedidos)

# Exportando para CSV (você usará esses arquivos para carregar no SQL)
df_clientes.to_csv("clientes.csv", index=False)
df_pedidos.to_csv("pedidos.csv", index=False)

print("Arquivos clientes.csv e pedidos.csv gerados com sucesso!")
