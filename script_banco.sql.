-- 3. CONSULTA ANALÍTICA PARA O RELATÓRIO
SELECT 
    u.nome,
    u.email,
    u.pais,
    SUM(p.valor_total) AS total_gasto
FROM usuario u
INNER JOIN pedidos p ON u.id = p.id_cliente
WHERE p.status = 'Entregue'
GROUP BY u.nome, u.email, u.pais
ORDER BY total_gasto DESC;
